# PostgreSQL / 服务端基础配置
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=learning_app
JWT_SECRET_KEY=change_to_a_long_random_secret
APP_ENV=development
ADMIN_PASSWORD=
STORE_IMAGE_RAW=0

# 云端 VLM（可选）。留空时完全关闭，不影响 OCR 与数据库规则。
# 默认是智谱 OpenAI 兼容接口；填写对应平台的 API Key 后重建 backend 即可。
VLM_API_KEY=
VLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VLM_MODEL=glm-4v-flash
VLM_TIMEOUT=25

# 成本与准确率控制
VLM_ACCEPT_MIN_CONF=0.75
VLM_GLOBAL_MIN_SECONDS=60
VLM_KEY_RETRY_SECONDS=300
VLM_CACHE_TTL_HOURS=6
VLM_MAX_IMAGES=3
VLM_FRAME_LOOKBACK_SECONDS=180
# 0=unknown 都可触发；1=仅 OCR 有效文字少于 VLM_OCR_MIN_CHARS 时触发
VLM_REQUIRE_LOW_OCR=0
VLM_OCR_MIN_CHARS=5

# 默认不允许模型自动生成长期规则；建议保持 0，先看真实截图评测。
VLM_AUTO_RULE_ENABLED=0
VLM_RULE_MIN_CONF=0.90
VLM_RULE_CONFIRMATIONS=2

# 若改用阿里云百炼兼容接口，可替换为对应地域的 Base URL 与视觉模型名：
# VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VLM_MODEL=qwen3-vl-flash
